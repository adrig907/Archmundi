# Copia este archivo como ".env" y rellena tus valores reales.
# El .env NUNCA debe subirse al repositorio (añádelo a .gitignore).

# --- Conexión a SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ArchivoMunicipal
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
# Si usas autenticación de Windows en vez de usuario/contraseña SQL,
# lo comentamos aparte más abajo en las notas.

# --- Autenticación ---
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000

# --- Almacenamiento de archivos (por ahora, disco local) ---
UPLOADS_DIR=./uploads
